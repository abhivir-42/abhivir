---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HighlightCard from "../components/HighlightCard.astro";
import { work } from "../data/work";
import { highlights } from "../data/highlights";

const featured = work.filter((w) => w.featured);

const featuredHighlightTitles = [
  "Imperial College London",
  "IIT Delhi, B.Tech",
  "Cambridge ENGAA: 9.0/9.0",
  "Imperial Cricket Captain",
  "YC Top 25: Dinner with YC Partners",
  "Winner: Wintermute Crypto CTF",
];
// Confirmed accurate by him on 1 Sep 2026 (anton/applications/master-record.md).
const experience = [
  { org: "Fetch.ai", role: "AI Engineer, Innovation Lab", when: "Apr – Sep 2025" },
  { org: "DeepSearch Labs", role: "Machine Learning Engineer", when: "Jan – Mar 2025" },
  { org: "Imperial College London", role: "AI Research, then MEng thesis at BioMedIA", when: "Oct 2024 – Jun 2026" },
  { org: "Imperial College London", role: "Undergraduate Teaching Assistant", when: "Oct 2024 – Mar 2025" },
  { org: "Govt. of Uttarakhand", role: "Software Engineer, Dept. of Rural Development", when: "Jul – Sep 2024" },
  { org: "Optiver", role: "Quantitative Trader, Trading Academy", when: "Nov – Dec 2023" },
];

const featuredHighlights = featuredHighlightTitles
  .map((title) => highlights.find((h) => h.title === title))
  .filter((h): h is NonNullable<typeof h> => Boolean(h));
---

<BaseLayout>
  <div class="editorial-container">
    <!-- Hero -->
    <section class="pt-20 pb-16 border-b border-border">
      <div class="flex items-start justify-between gap-6 mb-4">
        <h1
          class="font-display text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-[1.1]"
        >
          Abhivir Singh
        </h1>
        <img
          src="/apple-touch-icon.png"
          alt="Abhivir Singh"
          class="w-20 h-20 md:w-24 md:h-24 rounded-sm object-cover border border-border shrink-0"
        />
      </div>
      <p class="font-content text-xl md:text-2xl text-foreground leading-snug max-w-2xl">
        I build AI agent systems, and the harnesses underneath them.
      </p>
      <div class="max-w-2xl space-y-4 text-sm text-muted-foreground leading-relaxed mt-6">
        <p>
          At Fetch.ai I was the only engineer on a platform that turns a sentence about a dataset
          into a trained model. Version one was a fixed pipeline and it worked on every dataset I
          had tested it on, which was the tell. I rebuilt it as nine agents under a supervisor,
          with logging on every call, guardrails and evals, because I could not debug the thing I
          had. Seven Dockerised services by the end.
        </p>
        <p>
          I found out afterwards that the industry had names for most of it. On Imperial's NLP
          leaderboard I measured the thing directly: working by hand I came 10th of 340, my agent
          system running unsupervised came 22nd, and the two together came 1st. The harness was
          the difference, not the model.
        </p>
        <p>
          22, from Faridabad. MEng Computing (AI and Machine Learning) from Imperial, First Class
          Honours. Before that, a year at IIT Delhi.
        </p>
      </div>
    </section>

    <!-- Experience -->
    <section class="pt-12 pb-12 border-b border-border">
      <p class="section-label">Experience</p>
      <ul class="divide-y divide-border">
        {experience.map((job) => (
          <li class="py-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <div class="flex flex-wrap items-baseline gap-x-3">
              <span class="text-sm font-medium text-foreground">{job.org}</span>
              <span class="text-sm text-muted-foreground">{job.role}</span>
            </div>
            <span class="text-xs font-mono text-muted-foreground shrink-0">{job.when}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Highlights -->
    <section class="pt-12 pb-12 border-b border-border">
      <div class="flex items-center justify-between mb-6">
        <p class="section-label mb-0">Highlights</p>
        <a
          href="/highlights"
          class="text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          See all highlights &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredHighlights.map((item) => (
          <HighlightCard
            title={item.title}
            caption={item.caption}
            date={item.date}
            category={item.category}
            image={item.image}
            imagePosition={item.imagePosition}
            placeholder={item.placeholder}
            href={item.href}
          />
        ))}
      </div>
    </section>

    <!-- Featured Work -->
    <section class="pt-12 pb-12 border-b border-border">
      <div class="flex items-center justify-between mb-6">
        <p class="section-label mb-0">Featured Work</p>
        <a
          href="/work"
          class="text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          See all work &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {featured.map((project) => (
          <ProjectCard
            title={project.title}
            date={project.date}
            description={project.description}
            tags={project.tags}
            href={project.href}
            slug={project.slug}
            tier={project.tier}
          />
        ))}
      </div>
    </section>

    <!-- Right Now -->
    <section class="pt-12 pb-12 border-b border-border">
      <div class="flex items-center justify-between">
        <p class="section-label mb-0">Right Now</p>
        <a
          href="/now"
          class="text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          What I'm up to &rarr;
        </a>
      </div>
      <p class="text-sm text-muted-foreground mt-4">
        Graduated from Imperial. Building AI agents and the harnesses around them. In India, working out where to do the next serious thing.
      </p>
    </section>

    <!-- Contact -->
    <section class="pt-12 pb-16">
      <p class="section-label">Get in Touch</p>
      <p class="text-sm text-muted-foreground mb-6">
        I read everything that comes in.
      </p>
      <div class="flex items-center gap-4 flex-wrap">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 text-sm font-medium text-foreground bg-secondary px-4 py-2 rounded-sm hover:bg-card transition-colors border border-border"
        >
          Send a message &rarr;
        </a>
        <a
          href="https://www.linkedin.com/in/abhivir-singh/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
        >
          LinkedIn &nearr;
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
