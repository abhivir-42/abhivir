---
export const prerender = true;
const title = "Abhivir Singh · The Bridge";
const description = "A 60-second intro for EF · The Bridge.";
const posterUrl = "https://abhivir.com/videos/sf-the-bridge-poster.jpg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05060a" />
    <title>{title}</title>

    <!-- Social preview (this link gets shared with EF) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={posterUrl} />
    <meta property="og:url" content="https://abhivir.com/sf-the-bridge/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={posterUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <style is:global>
      :root {
        --bg: #05060a;
        --fg: #eef1f8;
        --muted: #98a2b8;
        --indigo: #6366f1;
        --cyan: #22d3ee;
        --violet: #8b5cf6;
        --pink: #ec4899;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Inter, Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        min-height: 100svh;
      }

      /* ---------- AI background layers ---------- */
      #net, .aurora, .grid, .vignette {
        position: fixed; inset: 0; z-index: 0; pointer-events: none;
      }
      .aurora { overflow: hidden; }
      .aurora::before, .aurora::after, .aurora i {
        content: ""; position: absolute; border-radius: 50%;
        filter: blur(90px); opacity: 0.55; mix-blend-mode: screen;
      }
      .aurora::before {
        width: 60vw; height: 60vw; left: -10vw; top: -15vw;
        background: radial-gradient(circle at 30% 30%, var(--indigo), transparent 60%);
        animation: drift1 22s ease-in-out infinite alternate;
      }
      .aurora::after {
        width: 55vw; height: 55vw; right: -12vw; top: 5vw;
        background: radial-gradient(circle at 50% 50%, var(--cyan), transparent 60%);
        animation: drift2 26s ease-in-out infinite alternate;
      }
      .aurora i {
        width: 50vw; height: 50vw; left: 25vw; bottom: -20vw;
        background: radial-gradient(circle at 50% 50%, var(--violet), transparent 60%);
        animation: drift3 30s ease-in-out infinite alternate;
      }
      @keyframes drift1 { to { transform: translate(8vw, 6vh) scale(1.1); } }
      @keyframes drift2 { to { transform: translate(-7vw, 8vh) scale(1.15); } }
      @keyframes drift3 { to { transform: translate(4vw, -8vh) scale(1.08); } }

      .grid {
        background-image:
          linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
        background-size: 46px 46px;
        -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 30%, transparent 80%);
        mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 30%, transparent 80%);
        opacity: 0.6;
      }
      .vignette {
        background: radial-gradient(ellipse 90% 80% at 50% 40%, transparent 55%, rgba(0,0,0,0.65) 100%);
      }

      /* ---------- Content ---------- */
      .stage {
        position: relative; z-index: 10;
        min-height: 100svh;
        display: flex; align-items: center; justify-content: center;
        gap: clamp(24px, 5vw, 72px);
        padding: 88px 24px 48px;
        flex-wrap: wrap;
      }

      .back {
        position: fixed; top: 18px; left: 18px; z-index: 40;
        display: inline-flex; align-items: center; gap: 8px;
        padding: 9px 15px; border-radius: 999px;
        font-size: 14px; font-weight: 500; letter-spacing: 0.01em;
        color: var(--fg); text-decoration: none;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.14);
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
      }
      .back:hover { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.28); transform: translateY(-1px); }
      .back svg { width: 16px; height: 16px; }

      /* video */
      .player { position: relative; flex: 0 0 auto; }
      .frame {
        position: relative; border-radius: 22px; overflow: hidden;
        background: #000;
        border: 1px solid rgba(255,255,255,0.12);
        box-shadow:
          0 0 0 1px rgba(99,102,241,0.25),
          0 30px 80px -20px rgba(34,211,238,0.35),
          0 20px 60px -30px rgba(139,92,246,0.5);
      }
      video {
        display: block;
        height: min(84svh, 720px);
        max-width: 92vw;
        width: auto;
        background: #000;
      }
      .caption {
        margin-top: 12px; text-align: center;
        font-size: 12.5px; letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--muted); font-variant-numeric: tabular-nums;
      }

      /* side panel */
      .side { max-width: 340px; min-width: 240px; }
      .kicker {
        font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase;
        color: var(--cyan); margin: 0 0 14px;
      }
      .side h1 {
        font-size: clamp(28px, 4vw, 40px); line-height: 1.05; margin: 0 0 14px;
        font-weight: 700; letter-spacing: -0.02em;
      }
      .side p { color: var(--muted); font-size: 15.5px; line-height: 1.6; margin: 0; }

      #intro, #thanks { transition: opacity 0.5s ease, transform 0.5s ease; }
      #intro.hide { opacity: 0; transform: translateY(-8px); pointer-events: none; position: absolute; }
      #thanks { opacity: 0; transform: translateY(10px); pointer-events: none; }
      #thanks.show { opacity: 1; transform: translateY(0); pointer-events: auto; position: static; }

      .gradient-text {
        background: linear-gradient(100deg, var(--cyan), var(--indigo) 45%, var(--violet) 80%, var(--pink));
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .cta {
        display: inline-flex; align-items: center; gap: 8px; margin-top: 22px;
        padding: 11px 18px; border-radius: 999px;
        font-size: 14.5px; font-weight: 600; text-decoration: none; color: #05060a;
        background: linear-gradient(100deg, var(--cyan), var(--indigo));
        box-shadow: 0 12px 30px -10px rgba(34,211,238,0.6);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .cta:hover { transform: translateY(-1px); box-shadow: 0 16px 36px -10px rgba(99,102,241,0.7); }

      #confetti { position: fixed; inset: 0; z-index: 60; pointer-events: none; }

      @media (max-width: 880px) {
        .stage { flex-direction: column; gap: 26px; padding-top: 72px; }
        .side { text-align: center; max-width: 92vw; }
        video { height: min(68svh, 620px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .aurora::before, .aurora::after, .aurora i { animation: none; }
      }
    </style>
  </head>

  <body>
    <canvas id="net"></canvas>
    <div class="aurora"><i></i></div>
    <div class="grid"></div>
    <div class="vignette"></div>

    <a class="back" href="/">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      abhivir.com
    </a>

    <main class="stage">
      <div class="player">
        <div class="frame">
          <video
            id="vid"
            controls
            playsinline
            preload="metadata"
            poster="/videos/sf-the-bridge-poster.jpg"
          >
            <source src="/videos/sf-the-bridge.mp4" type="video/mp4" />
            <p style="color:#98a2b8;padding:16px">
              Your browser can't play this video.
              <a href="/videos/sf-the-bridge.mp4" style="color:#22d3ee">Download the MP4</a>.
            </p>
          </video>
        </div>
        <div class="caption">60 seconds · sound on</div>
      </div>

      <aside class="side">
        <div id="intro">
          <p class="kicker">For EF · The Bridge</p>
          <h1>Abhivir Singh</h1>
          <p>A 60-second intro. Hit play, and turn the sound on.</p>
        </div>
        <div id="thanks">
          <p class="kicker">That's a wrap</p>
          <h1 class="gradient-text">Thanks for watching.</h1>
          <p>There's a lot more in the rest of my application. See you in the Bay.</p>
          <a class="cta" href="/">
            Explore abhivir.com
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </aside>
    </main>

    <canvas id="confetti"></canvas>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // ---- Neural-network background ----
        (function net() {
          var c = document.getElementById("net");
          if (!c || reduce) return;
          var ctx = c.getContext("2d");
          var W, H, dpr = Math.min(window.devicePixelRatio || 1, 2);
          function size() {
            W = c.width = Math.floor(innerWidth * dpr);
            H = c.height = Math.floor(innerHeight * dpr);
            c.style.width = innerWidth + "px";
            c.style.height = innerHeight + "px";
          }
          size();
          window.addEventListener("resize", size);
          var N = Math.max(28, Math.min(64, Math.floor(innerWidth / 24)));
          var nodes = [];
          for (var i = 0; i < N; i++) {
            nodes.push({
              x: Math.random() * W, y: Math.random() * H,
              vx: (Math.random() - 0.5) * 0.32 * dpr,
              vy: (Math.random() - 0.5) * 0.32 * dpr,
            });
          }
          var LINK = 150 * dpr;
          function tick() {
            ctx.clearRect(0, 0, W, H);
            for (var i = 0; i < N; i++) {
              var n = nodes[i];
              n.x += n.vx; n.y += n.vy;
              if (n.x < 0 || n.x > W) n.vx *= -1;
              if (n.y < 0 || n.y > H) n.vy *= -1;
            }
            for (var a = 0; a < N; a++) {
              for (var b = a + 1; b < N; b++) {
                var dx = nodes[a].x - nodes[b].x, dy = nodes[a].y - nodes[b].y;
                var d = Math.sqrt(dx * dx + dy * dy);
                if (d < LINK) {
                  var o = (1 - d / LINK) * 0.32;
                  ctx.strokeStyle = "rgba(99,102,241," + o + ")";
                  ctx.lineWidth = 1 * dpr;
                  ctx.beginPath();
                  ctx.moveTo(nodes[a].x, nodes[a].y);
                  ctx.lineTo(nodes[b].x, nodes[b].y);
                  ctx.stroke();
                }
              }
            }
            for (var k = 0; k < N; k++) {
              ctx.fillStyle = "rgba(34,211,238,0.7)";
              ctx.beginPath();
              ctx.arc(nodes[k].x, nodes[k].y, 1.7 * dpr, 0, 6.2832);
              ctx.fill();
            }
            requestAnimationFrame(tick);
          }
          tick();
        })();

        // ---- Confetti ----
        function fireConfetti() {
          var c = document.getElementById("confetti");
          if (!c) return;
          var ctx = c.getContext("2d");
          var dpr = Math.min(window.devicePixelRatio || 1, 2);
          var W = (c.width = Math.floor(innerWidth * dpr));
          var H = (c.height = Math.floor(innerHeight * dpr));
          c.style.width = innerWidth + "px";
          c.style.height = innerHeight + "px";
          var colors = ["#6366f1", "#22d3ee", "#8b5cf6", "#ec4899", "#f59e0b", "#34d399"];
          var P = [], N = 180;
          for (var i = 0; i < N; i++) {
            P.push({
              x: W * (0.5 + (Math.random() - 0.5) * 0.4),
              y: H * 0.32 + (Math.random() - 0.5) * 80 * dpr,
              vx: (Math.random() - 0.5) * 13 * dpr,
              vy: (Math.random() * -15 - 4) * dpr,
              g: (0.32 + Math.random() * 0.12) * dpr,
              s: (6 + Math.random() * 7) * dpr,
              rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 0.45,
              col: colors[i % colors.length],
              life: 0, max: 130 + Math.random() * 50,
            });
          }
          function tick() {
            ctx.clearRect(0, 0, W, H);
            var alive = false;
            for (var i = 0; i < P.length; i++) {
              var p = P[i];
              p.life++;
              if (p.life > p.max) continue;
              alive = true;
              p.vy += p.g; p.x += p.vx; p.y += p.vy; p.vx *= 0.99; p.rot += p.vr;
              var alpha = Math.max(0, 1 - p.life / p.max);
              ctx.save();
              ctx.globalAlpha = alpha;
              ctx.translate(p.x, p.y); ctx.rotate(p.rot);
              ctx.fillStyle = p.col;
              ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.6);
              ctx.restore();
            }
            if (alive) requestAnimationFrame(tick);
            else ctx.clearRect(0, 0, W, H);
          }
          tick();
        }

        // ---- End-of-video: thanks + confetti ----
        var v = document.getElementById("vid");
        var intro = document.getElementById("intro");
        var thanks = document.getElementById("thanks");
        var done = false;
        function finish() {
          if (done) return;
          done = true;
          if (intro) intro.classList.add("hide");
          if (thanks) thanks.classList.add("show");
          if (!reduce) fireConfetti();
        }
        if (v) {
          v.addEventListener("ended", finish);
          // allow replay to re-arm the celebration
          v.addEventListener("play", function () {
            if (v.currentTime < 1) {
              done = false;
              if (thanks) thanks.classList.remove("show");
              if (intro) intro.classList.remove("hide");
            }
          });
        }
      })();
    </script>
  </body>
</html>
