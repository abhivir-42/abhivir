---
export const prerender = true;
const title = "Abhivir Singh · The Bridge";
const description = "A 60-second intro for Entrepreneurs First · The Bridge.";
const poster = "/videos/sf-the-bridge-v3.jpg";
const video = "/videos/sf-the-bridge-v3.mp4";
const posterAbs = "https://abhivir.com" + poster;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6e00e2" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={posterAbs} />
    <meta property="og:url" content="https://abhivir.com/sf-the-bridge/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={posterAbs} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;0,800;1,500&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --purple: #6e00e2;
        --orange: #ff7f52;
        --mint: #dde8e3;
        --ink: #1c0a33;
        --serif: "Playfair Display", Georgia, "Times New Roman", serif;
        --sans: "Helvetica Neue", Helvetica, Arial, sans-serif;
        --mono: ui-monospace, "SF Mono", "Roboto Mono", Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--purple);
        color: #fff;
        font-family: var(--serif);
        -webkit-font-smoothing: antialiased;
      }
      .page { min-height: 100svh; display: flex; flex-direction: column; }

      /* header bar */
      .bar {
        position: relative; z-index: 30;
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 22px;
        border-bottom: 1px solid rgba(255,255,255,0.55);
      }
      .nav { font-family: var(--mono); font-size: 14px; letter-spacing: 0.02em; text-transform: uppercase; color: #fff; text-decoration: none; white-space: nowrap; }
      .nav:hover { color: var(--orange); }
      .wordmark {
        position: absolute; left: 50%; transform: translateX(-50%);
        font-family: var(--sans); font-weight: 800; text-transform: uppercase;
        letter-spacing: -0.015em; color: var(--orange);
        font-size: clamp(20px, 2.8vw, 34px); white-space: nowrap;
      }

      /* main */
      .stage {
        flex: 1; display: flex; align-items: center; justify-content: center;
        gap: clamp(28px, 5vw, 80px); padding: clamp(24px, 4vh, 56px) 24px; flex-wrap: wrap;
      }
      .player { flex: 0 0 auto; }
      .frame { border: 1px solid rgba(255,255,255,0.4); background: #000; line-height: 0; }
      video { display: block; height: min(74svh, 680px); max-width: 92vw; width: auto; background: #000; }
      .caption { margin-top: 12px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.72); }

      /* side */
      .side { max-width: 380px; min-width: 250px; }
      .kicker { font-family: var(--mono); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange); margin: 0 0 16px; }
      .side h1 { font-family: var(--serif); font-weight: 800; font-size: clamp(36px, 5vw, 60px); line-height: 1.02; margin: 0 0 18px; letter-spacing: -0.01em; }
      .side h1 .hook { color: var(--orange); font-weight: 700; }
      .lede { font-size: 19px; line-height: 1.5; margin: 0; color: rgba(255,255,255,0.92); }
      .biglink {
        display: inline-block; margin-top: 24px;
        font-family: var(--mono); font-size: 15px; letter-spacing: 0.02em; text-transform: uppercase;
        color: #fff; text-decoration: none; border-bottom: 2px solid var(--orange); padding-bottom: 3px;
      }
      .biglink:hover { color: var(--orange); }

      #intro, #thanks { transition: opacity .5s, transform .5s; }
      #intro.hide { opacity: 0; transform: translateY(-8px); pointer-events: none; position: absolute; }
      #thanks { opacity: 0; transform: translateY(10px); pointer-events: none; }
      #thanks.show { opacity: 1; transform: translateY(0); pointer-events: auto; position: static; }

      /* footer strip (EF mint) */
      .strip { background: var(--mint); color: var(--ink); padding: 16px 22px 20px; font-family: var(--mono); }
      .strip .rule { border-top: 1.5px dashed rgba(28,10,51,0.4); margin-bottom: 12px; }
      .strip .line { font-size: 14px; letter-spacing: 0.01em; }
      .strip .line b { color: var(--purple); }

      #confetti { position: fixed; inset: 0; z-index: 60; pointer-events: none; }

      @media (max-width: 880px) {
        .stage { flex-direction: column; gap: 24px; }
        .side { text-align: center; max-width: 92vw; }
        video { height: min(60svh, 560px); }
      }
      @media (max-width: 560px) {
        .wordmark { font-size: 16px; }
        .nav.right { display: none; }
      }
    </style>
  </head>

  <body>
    <div class="page">
      <header class="bar">
        <a class="nav left" href="/">[ &larr; abhivir.com ]</a>
        <span class="wordmark">Entrepreneurs First</span>
        <span class="nav right">[ The Bridge ]</span>
      </header>

      <main class="stage">
        <div class="player">
          <div class="frame">
            <video id="vid" controls playsinline preload="metadata" poster={poster}>
              <source src={video} type="video/mp4" />
              <p style="color:#fff;padding:16px;font-family:var(--mono)">Your browser can't play this video.
                <a href={video} style="color:#ff7f52">Download the MP4</a>.</p>
            </video>
          </div>
          <div class="caption">\\ 60 seconds · sound on</div>
        </div>

        <aside class="side">
          <div id="intro">
            <p class="kicker">\\ the 60-second version</p>
            <h1>Abhivir Singh</h1>
            <p class="lede">Press play, sound on.</p>
          </div>
          <div id="thanks">
            <p class="kicker">\\ that's a wrap</p>
            <h1><span class="hook">&#8627;</span> Thanks for watching.</h1>
            <p class="lede">There's a lot more in the rest of my application. See you in the Bay.</p>
            <a class="biglink" href="/">[ visit abhivir.com &rarr; ]</a>
          </div>
        </aside>
      </main>

      <footer class="strip">
        <div class="rule"></div>
        <div class="line">\\&nbsp;&nbsp;A 60-second intro for <b>The Bridge</b>. Found, don't follow.</div>
      </footer>
    </div>

    <canvas id="confetti"></canvas>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        function confetti() {
          var c = document.getElementById("confetti"); if (!c) return;
          var ctx = c.getContext("2d");
          var dpr = Math.min(window.devicePixelRatio || 1, 2);
          var W = (c.width = Math.floor(innerWidth * dpr));
          var H = (c.height = Math.floor(innerHeight * dpr));
          c.style.width = innerWidth + "px"; c.style.height = innerHeight + "px";
          var colors = ["#ffffff", "#ff7f52", "#ffd166", "#ffb38a", "#e9d4ff"];
          var P = [];
          for (var i = 0; i < 190; i++) P.push({
            x: W * (0.5 + (Math.random() - 0.5) * 0.5),
            y: H * 0.34 + (Math.random() - 0.5) * 80 * dpr,
            vx: (Math.random() - 0.5) * 13 * dpr, vy: (Math.random() * -15 - 4) * dpr,
            g: (0.32 + Math.random() * 0.12) * dpr, s: (6 + Math.random() * 7) * dpr,
            rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 0.45,
            col: colors[i % colors.length], life: 0, max: 130 + Math.random() * 55
          });
          (function tick() {
            ctx.clearRect(0, 0, W, H); var alive = false;
            for (var i = 0; i < P.length; i++) { var p = P[i]; p.life++; if (p.life > p.max) continue; alive = true;
              p.vy += p.g; p.x += p.vx; p.y += p.vy; p.vx *= 0.99; p.rot += p.vr;
              ctx.save(); ctx.globalAlpha = Math.max(0, 1 - p.life / p.max);
              ctx.translate(p.x, p.y); ctx.rotate(p.rot); ctx.fillStyle = p.col;
              ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.62); ctx.restore(); }
            if (alive) requestAnimationFrame(tick); else ctx.clearRect(0, 0, W, H);
          })();
        }
        var v = document.getElementById("vid");
        var intro = document.getElementById("intro");
        var thanks = document.getElementById("thanks");
        var done = false;
        function finish() { if (done) return; done = true;
          if (intro) intro.classList.add("hide");
          if (thanks) thanks.classList.add("show");
          if (!reduce) confetti(); }
        if (v) {
          v.addEventListener("ended", finish);
          v.addEventListener("play", function () { if (v.currentTime < 1) { done = false;
            if (thanks) thanks.classList.remove("show"); if (intro) intro.classList.remove("hide"); } });
        }
      })();
    </script>
  </body>
</html>
