---
export const prerender = true;
const title = "Abhivir Singh · The Bridge";
const description = "A 60-second intro for Entrepreneur First · The Bridge.";
const poster = "/videos/sf-the-bridge-v2.jpg";
const video = "/videos/sf-the-bridge-v2.mp4";
const posterAbs = "https://abhivir.com" + poster;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6e00e2" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={posterAbs} />
    <meta property="og:url" content="https://abhivir.com/sf-the-bridge/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={posterAbs} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <style is:global>
      :root {
        --purple: #6e00e2;
        --orange: #ff7f52;
        --white: #ffffff;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body {
        background: radial-gradient(125% 120% at 50% 0%, #7d1bf2 0%, #6e00e2 46%, #5400b4 100%);
        color: #fff;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Inter, Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100svh;
      }

      .stage {
        min-height: 100svh;
        display: flex; align-items: center; justify-content: center;
        gap: clamp(28px, 5vw, 72px);
        padding: 92px 24px 48px;
        flex-wrap: wrap;
      }

      .back {
        position: fixed; top: 18px; left: 18px; z-index: 40;
        display: inline-flex; align-items: center; gap: 8px;
        padding: 9px 16px; border-radius: 999px;
        font-size: 14px; font-weight: 600; color: #fff; text-decoration: none;
        background: rgba(255,255,255,0.10);
        border: 1.5px solid rgba(255,255,255,0.45);
        backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
        transition: background .2s, transform .2s;
      }
      .back:hover { background: rgba(255,255,255,0.20); transform: translateY(-1px); }
      .back svg { width: 16px; height: 16px; }

      .player { flex: 0 0 auto; }
      .frame {
        border-radius: 22px; overflow: hidden; background: #000;
        border: 1px solid rgba(255,255,255,0.25);
        box-shadow: 0 30px 70px -20px rgba(0,0,0,0.55), 0 0 0 6px rgba(255,255,255,0.06);
      }
      video { display: block; height: min(82svh, 720px); max-width: 92vw; width: auto; background: #000; }
      .caption {
        margin-top: 14px; text-align: center;
        font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase;
        color: rgba(255,255,255,0.7); font-weight: 600;
      }

      .side { max-width: 360px; min-width: 250px; }
      .lockup {
        display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px;
        padding: 7px 14px; border-radius: 999px;
        border: 1.5px solid rgba(255,255,255,0.4);
        font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #fff;
      }
      .lockup b { color: var(--orange); font-weight: 800; }
      .side h1 { font-size: clamp(30px, 4vw, 44px); line-height: 1.04; margin: 0 0 14px; font-weight: 800; letter-spacing: -0.02em; }
      .side p { color: rgba(255,255,255,0.82); font-size: 16px; line-height: 1.6; margin: 0; }
      .uline { box-shadow: inset 0 -0.32em 0 rgba(255,127,82,0.55); }

      #intro, #thanks { transition: opacity .5s, transform .5s; }
      #intro.hide { opacity: 0; transform: translateY(-8px); pointer-events: none; position: absolute; }
      #thanks { opacity: 0; transform: translateY(10px); pointer-events: none; }
      #thanks.show { opacity: 1; transform: translateY(0); pointer-events: auto; position: static; }

      .cta {
        display: inline-flex; align-items: center; gap: 8px; margin-top: 22px;
        padding: 12px 20px; border-radius: 999px;
        font-size: 14.5px; font-weight: 800; text-decoration: none; color: #2b0050;
        background: var(--orange);
        box-shadow: 0 12px 28px -10px rgba(255,127,82,0.7);
        transition: transform .2s, box-shadow .2s;
      }
      .cta:hover { transform: translateY(-1px); box-shadow: 0 16px 34px -10px rgba(255,127,82,0.85); }

      #confetti { position: fixed; inset: 0; z-index: 60; pointer-events: none; }

      @media (max-width: 880px) {
        .stage { flex-direction: column; gap: 26px; padding-top: 74px; }
        .side { text-align: center; max-width: 92vw; }
        .lockup { margin-left: auto; margin-right: auto; }
        video { height: min(66svh, 600px); }
      }
    </style>
  </head>

  <body>
    <a class="back" href="/">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      abhivir.com
    </a>

    <main class="stage">
      <div class="player">
        <div class="frame">
          <video id="vid" controls playsinline preload="metadata" poster={poster}>
            <source src={video} type="video/mp4" />
            <p style="color:#fff;padding:16px">Your browser can't play this video.
              <a href={video} style="color:#ff7f52">Download the MP4</a>.</p>
          </video>
        </div>
        <div class="caption">60 seconds · sound on</div>
      </div>

      <aside class="side">
        <div id="intro">
          <span class="lockup"><b>EF</b> · The Bridge</span>
          <h1>Abhivir Singh</h1>
          <p>A 60-second intro. Hit play, sound on.</p>
        </div>
        <div id="thanks">
          <span class="lockup"><b>EF</b> · The Bridge</span>
          <h1>Thanks for watching.</h1>
          <p>There's <span class="uline">a lot more</span> in the rest of my application. See you in the Bay.</p>
          <a class="cta" href="/">Explore abhivir.com
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </aside>
    </main>

    <canvas id="confetti"></canvas>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        function confetti() {
          var c = document.getElementById("confetti"); if (!c) return;
          var ctx = c.getContext("2d");
          var dpr = Math.min(window.devicePixelRatio || 1, 2);
          var W = (c.width = Math.floor(innerWidth * dpr));
          var H = (c.height = Math.floor(innerHeight * dpr));
          c.style.width = innerWidth + "px"; c.style.height = innerHeight + "px";
          var colors = ["#ffffff", "#ff7f52", "#ffd166", "#ffb38a", "#e9d4ff"];
          var P = [];
          for (var i = 0; i < 190; i++) P.push({
            x: W * (0.5 + (Math.random() - 0.5) * 0.45),
            y: H * 0.34 + (Math.random() - 0.5) * 80 * dpr,
            vx: (Math.random() - 0.5) * 13 * dpr, vy: (Math.random() * -15 - 4) * dpr,
            g: (0.32 + Math.random() * 0.12) * dpr, s: (6 + Math.random() * 7) * dpr,
            rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 0.45,
            col: colors[i % colors.length], life: 0, max: 130 + Math.random() * 55
          });
          (function tick() {
            ctx.clearRect(0, 0, W, H); var alive = false;
            for (var i = 0; i < P.length; i++) { var p = P[i]; p.life++; if (p.life > p.max) continue; alive = true;
              p.vy += p.g; p.x += p.vx; p.y += p.vy; p.vx *= 0.99; p.rot += p.vr;
              ctx.save(); ctx.globalAlpha = Math.max(0, 1 - p.life / p.max);
              ctx.translate(p.x, p.y); ctx.rotate(p.rot); ctx.fillStyle = p.col;
              ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.62); ctx.restore(); }
            if (alive) requestAnimationFrame(tick); else ctx.clearRect(0, 0, W, H);
          })();
        }
        var v = document.getElementById("vid");
        var intro = document.getElementById("intro");
        var thanks = document.getElementById("thanks");
        var done = false;
        function finish() { if (done) return; done = true;
          if (intro) intro.classList.add("hide");
          if (thanks) thanks.classList.add("show");
          if (!reduce) confetti(); }
        if (v) {
          v.addEventListener("ended", finish);
          v.addEventListener("play", function () { if (v.currentTime < 1) { done = false;
            if (thanks) thanks.classList.remove("show"); if (intro) intro.classList.remove("hide"); } });
        }
      })();
    </script>
  </body>
</html>
