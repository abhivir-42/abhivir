---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  /** Absolute-from-root path to a 1200x630 image. Defaults to the site card. */
  image?: string;
  /** "article" for blog posts, "profile" for the homepage. */
  type?: string;
  /** ISO date, for articles. */
  publishedAt?: string;
  /** Keep this page out of search results. */
  noindex?: boolean;
}

const {
  title = "Abhivir Singh",
  description =
    "Abhivir Singh builds AI agents and the systems around them. MEng Computing (AI and Machine Learning), Imperial College London, First Class Honours.",
  image = "/og.png",
  type = "website",
  publishedAt,
  noindex = false,
} = Astro.props;

const SITE = "https://abhivir.com";
const path = Astro.url.pathname;
const canonical = new URL(path === "/" ? "/" : path.replace(/\/*$/, "/"), SITE).href;
const ogImage = new URL(image, SITE).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abhivir Singh",
  url: SITE,
  image: new URL("/photos/imperial.jpg", SITE).href,
  jobTitle: "AI Engineer",
  email: "mailto:abhivir42@gmail.com",
  nationality: "Indian",
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Imperial College London",
      sameAs: "https://www.imperial.ac.uk/",
    },
  ],
  description:
    "MEng Computing (Artificial Intelligence and Machine Learning), Imperial College London, First Class Honours. Read one year at IIT Delhi before transferring.",
  knowsAbout: [
    "AI agents",
    "Large language models",
    "Machine learning",
    "Medical imaging",
    "Systems programming",
  ],
  sameAs: [
    "https://github.com/abhivir-42",
    "https://www.linkedin.com/in/abhivir-singh/",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Abhivir Singh" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Set before first paint so the page never flashes the wrong ground.
      try {
        const stored = localStorage.getItem("theme");
        const dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch (e) {}
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Abhivir Singh"
      href="/rss.xml"
    />
    <meta name="theme-color" content="#f0e9dc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17140f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Abhivir Singh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Abhivir Singh. AI agents, and the systems that make them hold together." />
    <meta property="og:locale" content="en_GB" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <SiteHeader />
      <main class="flex-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
